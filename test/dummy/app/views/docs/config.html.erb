<% dummy_page_nav(title: "Config", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Product knobs for Terms: mount path, optional scroll-to-end, optional request provenance, optional required categories.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioTermsAndConditions.configure do |config|
        config.mount_path = "/recording_studio_terms_and_conditions"
        config.require_scroll_to_end = false
        config.capture_request_provenance = false
        config.required_categories = nil
      end
    CODE
  ) %>
</div>
