<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Domain helpers plus the host Agree control.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Accept",
    subtitle: "RecordingStudioTermsAndConditions.accept!"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      terms = RecordingStudioTermsAndConditions.current_published_for(workspace)
      RecordingStudioTermsAndConditions.accept!(user, terms, { "source" => "clickwrap" })
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Agree helper",
    subtitle: "recording_studio_terms_agree"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :erb,
    code: [
      "<" + "%= recording_studio_terms_agree %" + ">",
      "<" + "%= recording_studio_terms_agree(inside_form: true) %" + ">",
      "<" + "%= recording_studio_terms_agree(link_terms: true) %" + ">"
    ].join("\n")
  ) %>
</div>
