<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Domain helpers plus the host Agree control.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Accept",
    subtitle: "RecordingStudioTermsAndConditions.accept!"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      terms = RecordingStudioTermsAndConditions.current_published_for(workspace)
      RecordingStudioTermsAndConditions.accept!(user, terms, { "source" => "clickwrap" })
      RecordingStudioTermsAndConditions.current_published_for(workspace, kind: "privacy")
      RecordingStudioTermsAndConditions.current_published_by_kind(workspace)
      RecordingStudioTermsAndConditions.pending_published_list(user, workspace)
      RecordingStudioTermsAndConditions.requires_acceptance?(user, workspace, required_kinds: %w[terms])
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Agree helper",
    subtitle: "recording_studio_terms_agree"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :erb,
    code: [
      "<" + "%= recording_studio_terms_agree %" + ">",
      "<" + "%= recording_studio_terms_agree(inside_form: true) %" + ">",
      "<" + "%= recording_studio_terms_agree(link_terms: true) %" + ">",
      "<" + "%= recording_studio_terms_scroll_to_end(require_scroll_to_end: true) do %" + ">",
      "  …live copy and sentinel…",
      "  <" + "%= recording_studio_terms_agree_button(require_scroll_to_end: true) %" + ">",
      "<" + "% end %" + ">"
    ].join("\n")
  ) %>
</div>
