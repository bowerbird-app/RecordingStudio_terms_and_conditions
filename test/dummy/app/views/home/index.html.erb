<% dummy_page_nav(title: "Terms demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Terms demo",
    subtitle: "This dummy app is the browser-facing demo surface for the addon.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <% if (admin_recording = dummy_admin_root_recording) %>
      <%= render FlatPack::Button::Component.new(
        text: "Admin",
        style: :secondary,
        url: "/recording_studio_root_switchable/v1/root_switch?scope=all_workspaces",
        method: :patch,
        params: { root_switch: { root_recording_id: admin_recording.id, return_to: "/admin" } }
      ) %>
    <% else %>
      <%= render FlatPack::Button::Component.new(
        text: "Admin",
        style: :secondary,
        href: "/admin"
      ) %>
    <% end %>
    <% if (terms_page = dummy_published_page_url(RecordingStudioTermsAndConditions::Terms::KIND_TERMS)) %>
      <%= render FlatPack::Button::Component.new(
        text: "Terms and Condition page",
        style: :secondary,
        href: terms_page
      ) %>
    <% end %>
    <% if (privacy_page = dummy_published_page_url(RecordingStudioTermsAndConditions::Terms::KIND_PRIVACY)) %>
      <%= render FlatPack::Button::Component.new(
        text: "Privacy Policy page",
        style: :secondary,
        href: privacy_page
      ) %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: "Helper",
      style: :secondary,
      href: "/agree_helper"
    ) %>
  </div>
</div>
