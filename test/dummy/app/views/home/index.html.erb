<% dummy_page_nav(title: "Terms demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Terms demo",
    subtitle: "This dummy app is the browser-facing demo surface for the addon.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Admin",
      style: :ghost,
      href: "/admin"
    ) %>
    <% if (terms_page = dummy_published_page_url(RecordingStudioTermsAndConditions::Terms::KIND_TERMS)) %>
      <%= render FlatPack::Button::Component.new(
        text: "Terms and Condition page",
        style: :ghost,
        href: terms_page
      ) %>
    <% end %>
    <% if (privacy_page = dummy_published_page_url(RecordingStudioTermsAndConditions::Terms::KIND_PRIVACY)) %>
      <%= render FlatPack::Button::Component.new(
        text: "Privacy Policy page",
        style: :ghost,
        href: privacy_page
      ) %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: "Helper",
      style: :ghost,
      href: "/agree_helper"
    ) %>
  </div>
</div>
