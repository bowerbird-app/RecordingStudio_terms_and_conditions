# frozen_string_literal: true

namespace :tailwindcss do
  desc "Link installed engines so Tailwind @source paths do not depend on the Bundler checkout directory"
  task link_engine_sources: :environment do
    destination = Rails.root.join("vendor/engines")
    FileUtils.mkdir_p(destination)
    root = Rails.root.realpath

    specs = Gem.loaded_specs.each_value.select do |spec|
      next false unless spec.name == "flat_pack" || spec.name.start_with?("recording_studio")

      path = Pathname.new(spec.full_gem_path).realpath
      path != root && !root.to_s.start_with?("#{path}/")
    end

    linked = specs.map do |spec|
      target = Pathname.new(spec.full_gem_path).realpath
      link = destination.join(spec.name)

      if link.symlink?
        current = Pathname.new(File.readlink(link))
        current = (link.dirname / current).cleanpath unless current.absolute?
        link.delete unless current == target
      elsif link.exist?
        raise "#{link} exists and is not a symlink to #{target}"
      end

      File.symlink(target, link) unless link.symlink?
      spec.name
    end

    stale = destination.children.select(&:symlink?).map { |path| path.basename.to_s } - linked
    stale.each { |name| destination.join(name).delete }

    lines = ["/* Generated by tailwindcss:link_engine_sources. Do not commit. */"]
    linked.sort.each do |name|
      %w[app/components app/helpers app/views].each do |relative|
        next unless destination.join(name, relative).directory?

        lines << %(@source "../../../vendor/engines/#{name}/#{relative}";)
      end
    end
    Rails.root.join("app/assets/tailwind/bundled_sources.css").write("#{lines.join("\n")}\n")
  end
end

%w[tailwindcss:build tailwindcss:watch].each do |task_name|
  next unless Rake::Task.task_defined?(task_name)

  Rake::Task[task_name].enhance(["tailwindcss:link_engine_sources"])
end
