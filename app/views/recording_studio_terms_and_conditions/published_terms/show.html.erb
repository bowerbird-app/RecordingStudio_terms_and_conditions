<% if respond_to?(:recording_studio_page_nav) %>
  <% recording_studio_page_nav(title: @terms&.title.presence || "Terms") %>
<% end %>
<% if respond_to?(:publishable_document_title) %>
  <% content_for :title, publishable_document_title.presence || (@terms&.title.presence || "Terms") %>
<% end %>

<% preview_badge = respond_to?(:publishable_preview_badge) ? publishable_preview_badge : nil %>
<%= render "recording_studio_terms_and_conditions/published_terms/document",
           terms: @terms,
           preview_badge: preview_badge %>
