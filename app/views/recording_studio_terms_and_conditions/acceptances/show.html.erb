<% agree_documents = @pending_terms.presence || Array(@terms).compact %>
<% terms_skip_page_nav %>

<% if agree_documents.blank? %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "Nothing to agree to yet",
    description: "Someone still needs to publish terms for this workspace."
  ) %>
<% else %>
  <div class="space-y-4">
    <%= render FlatPack::PageTitle::Component.new(
      title: terms_accept_page_title(@terms, reaccepting: @reaccepting),
      subtitle: terms_heading_date(@terms),
      variant: :h1
    ) %>

    <% agree_documents.each_with_index do |document, index| %>
      <%= render FlatPack::Collapse::Component.new(
        id: agree_documents.size == 1 ? "agree-terms-body" : "agree-terms-body-#{index}",
        title: terms_agree_heading(document),
        open: false
      ) do %>
        <%= terms_content(document.body) %>
      <% end %>
    <% end %>

    <% unless @already_accepted %>
      <%= form_with url: acceptance_path, method: :post do %>
        <div class="mb-6">
          <%= recording_studio_terms_continue_notice(
            actor: current_user,
            root: @root,
            pending: @pending_terms,
            link: false
          ) %>
        </div>
        <%= recording_studio_terms_agree_button(
          require_scroll_to_end: false,
          text: "Continue"
        ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
