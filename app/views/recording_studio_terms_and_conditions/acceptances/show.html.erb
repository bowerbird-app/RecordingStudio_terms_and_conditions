<% terms_page_nav(title: "Agree", back_url: main_app.root_path) %>

<%= render FlatPack::PageTitle::Component.new(
  title: @terms&.title.presence || "Terms",
  subtitle: "The live version for this workspace.",
  variant: :h1
) %>
<div class="-mt-5 mb-6">
  <%= terms_version_date(@terms) %>
</div>

<% if @terms.blank? %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "Nothing to agree to yet",
    description: "Someone still needs to publish terms for this workspace."
  ) %>
<% else %>
  <%= terms_content(@terms.body) %>
  <% unless @already_accepted %>
    <%= form_with url: acceptance_path, method: :post do %>
      <%= recording_studio_terms_agree(inside_form: true, actor: current_user, root: @root) %>
      <%= render FlatPack::Button::Component.new(
        text: "Agree",
        style: :primary,
        type: "submit"
      ) %>
    <% end %>
  <% end %>
<% end %>
