<% terms_page_nav(title: @terms.title, back_url: admin_terms_path, back_label: "Terms") %>

<%= render FlatPack::PageTitle::Component.new(
  title: @terms.title,
  subtitle: terms_heading_date(@terms, recording: @terms_recording),
  variant: :h1
) do |page_title| %>
  <% page_title.slot do %>
    <%= render FlatPack::Button::Component.new(
      text: "Users",
      style: :secondary,
      href: admin_term_users_path(@terms_recording)
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Edit",
      style: :secondary,
      href: edit_admin_term_path(@terms_recording)
    ) %>
    <%= terms_publishable_quick_actions(@terms_recording) %>
  <% end %>
<% end %>

<div class="mb-6">
  <p class="mt-1 text-sm text-[var(--surface-muted-content-color)]">
    Recording <%= @terms_recording.id %> · snapshot <%= @terms.id %>
  </p>
</div>

<%= terms_content(@terms.body) %>
