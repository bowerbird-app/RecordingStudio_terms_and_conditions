<% terms_page_nav(title: "Write terms", back_url: admin_terms_path, back_label: "Terms") %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Write terms",
  subtitle: "Save a draft. Publish when it should go live.",
  variant: :h1
) %>

<%= form_with url: admin_terms_path, method: :post, scope: :terms do %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <%= render "form", title: @title, body: @body %>
    <% end %>
    <% card.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Save draft",
        style: :primary,
        type: "submit"
      ) %>
    <% end %>
  <% end %>
<% end %>
