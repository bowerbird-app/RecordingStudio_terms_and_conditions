<% terms_page_nav(title: "Edit", back_url: admin_term_path(@terms_recording), back_label: "Terms") %>

<div class="mx-auto flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit",
    subtitle: "Live wording stays put. This save is a draft until you publish.",
    variant: :h1
  ) %>

  <%= form_with url: admin_term_path(@terms_recording), method: :patch, scope: :terms, class: "flex w-full flex-col gap-6" do %>
    <%= render "form", title: @title, body: @body %>
    <div class="inline-block">
      <%= render FlatPack::Button::Component.new(
        text: "Save draft",
        style: :primary,
        type: "submit"
      ) %>
    </div>
  <% end %>
</div>
