<% terms_page_nav(title: "Edit", back_url: admin_term_path(@terms_recording), back_label: "Terms") %>

<div class="mx-auto flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit",
    subtitle: "Nothing goes live until you release.",
    variant: :h1
  ) %>

  <div class="self-start">
    <%= render FlatPack::Badge::Component.new(
      text: @unreleased ? "Unreleased changes" : "Live copy matches",
      style: @unreleased ? :warning : :success,
      size: :sm
    ) %>
  </div>

  <div class="inline-block flex gap-3">
    <%= render FlatPack::Button::Component.new(text: "Review", style: :secondary, href: changes_admin_term_path(@terms_recording)) %>
    <%= render FlatPack::Button::Component.new(text: "Release", style: :primary, href: preview_admin_term_path(@terms_recording)) %>
  </div>

  <% @sections.each_with_index do |section, index| %>
    <section class="flex w-full flex-col gap-4">
      <h2 class="text-lg font-semibold"><%= section.number %>. <%= section.heading %></h2>
      <%= form_with url: admin_term_section_path(@terms_recording, section.recording), method: :patch, scope: :section, class: "flex w-full flex-col gap-3" do %>
        <%= render FlatPack::TextInput::Component.new(name: "section[heading]", value: section.heading, label: "Heading", required: true) %>
        <div class="inline-block">
          <%= render FlatPack::Button::Component.new(text: "Save heading", style: :secondary, size: :sm, type: "submit") %>
        </div>
      <% end %>
      <div class="flex gap-2">
        <% if index.positive? %>
          <%= form_with url: move_admin_term_section_path(@terms_recording, section.recording), method: :post do %>
            <%= hidden_field_tag :to_index, index - 1 %>
            <%= render FlatPack::Button::Component.new(text: "Up", style: :ghost, size: :sm, type: "submit") %>
          <% end %>
        <% end %>
        <% if index < @sections.size - 1 %>
          <%= form_with url: move_admin_term_section_path(@terms_recording, section.recording), method: :post do %>
            <%= hidden_field_tag :to_index, index + 1 %>
            <%= render FlatPack::Button::Component.new(text: "Down", style: :ghost, size: :sm, type: "submit") %>
          <% end %>
        <% end %>
        <%= form_with url: admin_term_section_path(@terms_recording, section.recording), method: :delete do %>
          <%= render FlatPack::Button::Component.new(text: "Remove section", style: :ghost, size: :sm, type: "submit") %>
        <% end %>
      </div>

      <% section.clauses.each_with_index do |clause, clause_index| %>
        <div class="flex w-full flex-col gap-3 pl-4">
          <h3 class="font-medium"><%= clause.number %></h3>
          <%= form_with url: admin_term_clause_path(@terms_recording, clause.recording), method: :patch, scope: :clause, class: "flex w-full flex-col gap-3" do %>
            <%= render FlatPack::TextArea::Component.new(name: "clause[body]", value: clause.body, label: "Clause", required: true, rows: 4) %>
            <div class="inline-block">
              <%= render FlatPack::Button::Component.new(text: "Save clause", style: :secondary, size: :sm, type: "submit") %>
            </div>
          <% end %>
          <div class="flex gap-2">
            <% if clause_index.positive? %>
              <%= form_with url: move_admin_term_clause_path(@terms_recording, clause.recording), method: :post do %>
                <%= hidden_field_tag :to_index, clause_index - 1 %>
                <%= render FlatPack::Button::Component.new(text: "Up", style: :ghost, size: :sm, type: "submit") %>
              <% end %>
            <% end %>
            <% if clause_index < section.clauses.size - 1 %>
              <%= form_with url: move_admin_term_clause_path(@terms_recording, clause.recording), method: :post do %>
                <%= hidden_field_tag :to_index, clause_index + 1 %>
                <%= render FlatPack::Button::Component.new(text: "Down", style: :ghost, size: :sm, type: "submit") %>
              <% end %>
            <% end %>
            <%= form_with url: admin_term_clause_path(@terms_recording, clause.recording), method: :delete do %>
              <%= render FlatPack::Button::Component.new(text: "Remove clause", style: :ghost, size: :sm, type: "submit") %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= form_with url: admin_term_section_clauses_path(@terms_recording, section.recording), method: :post, scope: :clause, class: "flex w-full flex-col gap-3" do %>
        <%= render FlatPack::TextArea::Component.new(name: "clause[body]", value: "", label: "New clause", rows: 3) %>
        <div class="inline-block">
          <%= render FlatPack::Button::Component.new(text: "Add clause", style: :secondary, size: :sm, type: "submit") %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%= form_with url: admin_term_sections_path(@terms_recording), method: :post, scope: :section, class: "flex w-full flex-col gap-3" do %>
    <%= render FlatPack::TextInput::Component.new(name: "section[heading]", value: "", label: "New section", required: true) %>
    <div class="inline-block">
      <%= render FlatPack::Button::Component.new(text: "Add section", style: :primary, type: "submit") %>
    </div>
  <% end %>
</div>
