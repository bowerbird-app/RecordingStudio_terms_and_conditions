<% terms_page_nav(title: "Edit terms", back_url: admin_term_path(@terms_recording), back_label: "Terms") %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Edit terms",
  subtitle: "This writes a new version. People must agree again after you publish.",
  variant: :h1
) %>

<%= form_with url: admin_term_path(@terms_recording), method: :patch, scope: :terms do %>
  <%= render FlatPack::TextInput::Component.new(
    name: "terms[title]",
    value: @terms.title,
    label: "Title",
    required: true
  ) %>
  <%= render FlatPack::TextArea::Component.new(
    name: "terms[body]",
    value: @terms.body,
    label: "Body",
    required: true,
    rows: 12
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: "Save version",
    style: :primary,
    type: "submit"
  ) %>
<% end %>
