<% terms_page_nav(title: "Terms", back_url: main_app.root_path) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Terms",
  subtitle: "Draft here. Publish next door.",
  variant: :h1
) do |page_title| %>
  <% page_title.slot do %>
    <%= render FlatPack::Button::Component.new(
      text: "Write terms",
      style: :primary,
      href: new_admin_term_path
    ) %>
  <% end %>
<% end %>

<% if @terms_recordings.blank? %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "No terms yet",
    description: "Write a draft, then publish it when the wording is ready."
  ) %>
<% else %>
  <% title_column = lambda { |recording|
    render FlatPack::Link::Component.new(href: admin_term_path(recording)) {
      recording.recordable&.title.presence || "Untitled"
    }
  } %>
  <% status_column = lambda { |recording|
    live = recording.respond_to?(:currently_published?) && recording.currently_published?
    render FlatPack::Badge::Component.new(
      text: live ? "Live" : "Draft",
      style: live ? :success : :default,
      size: :sm
    )
  } %>
  <% agrees_column = lambda { |recording|
    RecordingStudioTermsAndConditions::Acceptance.where(terms_recording_id: recording.id).count
  } %>
  <% open_column = lambda { |recording|
    render FlatPack::Button::Component.new(
      text: "Open",
      style: :ghost,
      size: :sm,
      href: admin_term_path(recording)
    )
  } %>

  <%= render FlatPack::Table::Component.new(
    data: @terms_recordings,
    min_width: :lg
  ) do |table| %>
    <% table.column(title: "Title", html: title_column) %>
    <% table.column(title: "Status", html: status_column) %>
    <% table.column(title: "Agrees", html: agrees_column) %>
    <% table.column(title: "", html: open_column) %>
  <% end %>
<% end %>
