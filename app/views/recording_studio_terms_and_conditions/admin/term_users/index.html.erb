<% terms_page_nav(title: "Agreement history", back_url: admin_term_path(@terms_recording), back_label: @terms.title) %>

<div class="mx-auto flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Agreement history",
    subtitle: terms_users_subtitle(@terms),
    variant: :h1
  ) %>

  <% if @versions.blank? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No released versions yet.",
      description: "Release this document before people can agree."
    ) %>
  <% else %>
    <%= render FlatPack::List::Component.new(divider: true, class: "w-full") do %>
      <% @versions.each do |version| %>
        <%= render FlatPack::List::Item.new(
          href: admin_term_user_path(@terms_recording, version.terms_id),
          title: terms_released_label(version.released_at),
          subtitle: version.title.presence,
          hover: true,
          trailing: terms_agreed_count(version.agreement_count)
        ) %>
      <% end %>
    <% end %>
    <%= terms_table_pagination(@pagy) %>
  <% end %>
</div>
